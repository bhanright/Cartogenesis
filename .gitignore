*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/build/
*/build/
/captures
.externalNativeBuild
.cxx
local.properties

# Signing material — never commit these.
keystore.properties
*.jks
*.keystore

# Kotlin compiler scratch output
.kotlin/

# Packaged builds for distribution. Regenerate with :desktop:createDistributable
# and :desktop:packageMsi; a hundred megabytes of bundled JVM does not belong in git.
/dist/

# Local notes about where and how this is deployed. Deliberately not published: the repo is public
# and these describe private infrastructure rather than the program. Ignored rather than merely
# left untracked, so a `git add -A` cannot sweep them in by accident.
/HOSTING.md

# Worktrees for parallel chunks of work, each in its own checkout here;
# they are merged by branch and must never be committed as files.
/.claude/worktrees/

# Throwaway probes. A chunk writes one to measure something or to regenerate a fixture, and it
# is not part of the suite: every module, not just the desktop one, so a probe cannot be committed
# from wherever it happened to be written.
**/SeedProbe*.kt

# Working notes for the maintainer; not part of the repository.
/notes/

# Python bytecode, written beside .github/scripts/audit_summary.py whenever something imports it.
__pycache__/
